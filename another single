# ============================================================
# PLOTTING FUNCTION
# ============================================================

def plot_single_modified_plus_dev(
    df,
    stream="Oil"
):

    d = df.copy()


    # --------------------------------------------------------
    # SELECT STREAM
    # --------------------------------------------------------

    if stream == "Oil":

        rmod = "Oil_BPD_Modified"
        rdev = "Oil_BPD_Dev"
        rcombined = "Oil_BPD_Combined"

        cmod = "Cum_Oil_Modified"
        cdev = "Cum_Oil_Dev"
        ccombined = "Cum_Oil_Combined"

        rate_unit = "BPD"
        cum_unit = "BBL"

    else:

        rmod = "Gas_MCFD_Modified"
        rdev = "Gas_MCFD_Dev"
        rcombined = "Gas_MCFD_Combined"

        cmod = "Cum_Gas_Modified"
        cdev = "Cum_Gas_Dev"
        ccombined = "Cum_Gas_Combined"

        rate_unit = "MCF/D"
        cum_unit = "MCF"


    # --------------------------------------------------------
    # CLEAN DATA
    # --------------------------------------------------------

    d["Date"] = pd.to_datetime(
        d["Date"],
        errors="coerce"
    )


    d = d[
        d["Date"].notna()
    ].copy()


    d = d[
        (d["Date"].dt.year >= 2026)
        &
        (d["Date"].dt.year <= 2100)
    ].copy()


    for col in [

        rmod,
        rdev,
        rcombined,
        cmod,
        cdev,
        ccombined

    ]:

        d[col] = pd.to_numeric(
            d[col],
            errors="coerce"
        ).fillna(0)


    d = (

        d.sort_values("Date")
        .reset_index(drop=True)

    )


    if len(d) == 0:

        print(
            f"No valid {stream} data."
        )

        return


    # --------------------------------------------------------
    # PYTHON DATETIME X VALUES
    # --------------------------------------------------------

    x = list(
        d["Date"]
        .dt.to_pydatetime()
    )


    modified_rate = (
        d[rmod]
        .to_numpy(dtype=float)
    )


    dev_rate = (
        d[rdev]
        .to_numpy(dtype=float)
    )


    combined_rate = (
        d[rcombined]
        .to_numpy(dtype=float)
    )


    modified_cum = (
        d[cmod]
        .to_numpy(dtype=float)
    )


    dev_cum = (
        d[cdev]
        .to_numpy(dtype=float)
    )


    combined_cum = (
        d[ccombined]
        .to_numpy(dtype=float)
    )


    # --------------------------------------------------------
    # SUMMARY NUMBERS
    # --------------------------------------------------------

    peak_modified = np.max(
        modified_rate
    )


    peak_combined = np.max(
        combined_rate
    )


    peak_dev_addition = np.max(
        dev_rate
    )


    final_modified = (
        modified_cum[-1]
    )


    final_dev = (
        dev_cum[-1]
    )


    final_combined = (
        combined_cum[-1]
    )


    increment = (
        final_combined
        -
        final_modified
    )


    if final_modified != 0:

        increment_pct = (

            increment
            /
            final_modified
            *
            100

        )

        pct_text = (
            f"{increment_pct:+.2f}%"
        )

    else:

        pct_text = "N/A"


    # --------------------------------------------------------
    # FIGURE
    # --------------------------------------------------------

    fig, ax1 = plt.subplots(
        figsize=(14, 7)
    )

    ax2 = ax1.twinx()


    # --------------------------------------------------------
    # RATE LINES
    # --------------------------------------------------------

    modified_line, = ax1.plot(

        x,

        modified_rate,

        linewidth=2,

        label="Modified Profile"

    )


    combined_line, = ax1.plot(

        x,

        combined_rate,

        linewidth=2,

        label=(
            "Modified + Confirmed Future Dev"
        )

    )


    # Incremental rate shading
    ax1.fill_between(

        x,

        modified_rate,

        combined_rate,

        color="green",

        alpha=0.30

    )


    # --------------------------------------------------------
    # CUMULATIVE LINES
    # --------------------------------------------------------

    modified_cum_line, = ax2.plot(

        x,

        modified_cum,

        linestyle="--",

        linewidth=2,

        label="Modified Cumulative"

    )


    combined_cum_line, = ax2.plot(

        x,

        combined_cum,

        linestyle="--",

        linewidth=2,

        label=(
            "Modified + Confirmed Future Dev "
            "Cumulative"
        )

    )


    # Incremental cumulative shading
    ax2.fill_between(

        x,

        modified_cum,

        combined_cum,

        color="green",

        alpha=0.10

    )


    # --------------------------------------------------------
    # NOTE
    # --------------------------------------------------------

    note = (

        f"Peak Modified: "
        f"{peak_modified:,.0f} "
        f"{rate_unit}\n"

        f"Peak w/ Confirmed Dev: "
        f"{peak_combined:,.0f} "
        f"{rate_unit}\n"

        f"Max Confirmed Dev Addition: "
        f"{peak_dev_addition:,.0f} "
        f"{rate_unit}\n"

        f"Confirmed Dev Increment: "
        f"{increment:,.0f} "
        f"{cum_unit}\n"

        f"Increment vs Modified: "
        f"{pct_text}"

    )


    ax1.text(

        0.015,

        0.97,

        note,

        transform=ax1.transAxes,

        va="top",

        ha="left",

        bbox=dict(

            boxstyle="round",

            facecolor="white",

            alpha=0.85

        )

    )


    # --------------------------------------------------------
    # TITLES / LABELS
    # --------------------------------------------------------

    ax1.set_title(

        f"{FACILITY_TO_PLOT} - "
        f"{stream}: Modified + "
        f"Confirmed Future Dev"

    )


    ax1.set_xlabel(
        "Date"
    )


    ax1.set_ylabel(

        f"{stream} Rate "
        f"({rate_unit})"

    )


    ax2.set_ylabel(

        f"Cumulative {stream} "
        f"({cum_unit})"

    )


    ax1.grid(
        True,
        alpha=0.30
    )


    # --------------------------------------------------------
    # LEGEND
    # --------------------------------------------------------

    ax1.legend(

        [

            modified_line,

            combined_line,

            modified_cum_line,

            combined_cum_line

        ],

        [

            "Modified Profile",

            "Modified + Confirmed Future Dev",

            "Modified Cumulative",

            "Modified + Confirmed Future Dev Cumulative"

        ],

        loc="upper right"

    )


    # --------------------------------------------------------
    # SHOW
    # --------------------------------------------------------

    plt.show()


