# ============================================================
# WELL NAME NORMALIZATION
# ============================================================

def normalize_well_name(name):

    if pd.isna(name):
        return ""

    return (
        str(name)
        .strip()
        .upper()
    )


# ============================================================
# ROBUST FUTURE DEVELOPMENT DATE PARSER
# ============================================================

def parse_dev_dates(series):

    s = series.copy()

    parsed = pd.Series(
        pd.NaT,
        index=s.index,
        dtype="datetime64[ns]"
    )

    text_values = (
        s.astype(str)
        .str.strip()
    )

    # --------------------------------------------------------
    # Try Jan-26 style
    # --------------------------------------------------------

    month_year = pd.to_datetime(
        text_values,
        format="%b-%y",
        errors="coerce"
    )

    good = month_year.notna()

    parsed.loc[good] = month_year.loc[good]


    # --------------------------------------------------------
    # Try general date formats
    # --------------------------------------------------------

    missing = parsed.isna()

    if missing.any():

        general = pd.to_datetime(
            text_values[missing],
            errors="coerce"
        )

        good_general = general.notna()

        parsed.loc[
            general.index[good_general]
        ] = general.loc[good_general]


    # --------------------------------------------------------
    # Try Excel serial dates
    # --------------------------------------------------------

    missing = parsed.isna()

    if missing.any():

        numeric = pd.to_numeric(
            s[missing],
            errors="coerce"
        )

        excel_mask = (
            numeric.notna()
            &
            (numeric >= 1)
            &
            (numeric <= 150000)
        )

        if excel_mask.any():

            excel_dates = pd.to_datetime(
                numeric[excel_mask],
                unit="D",
                origin="1899-12-30",
                errors="coerce"
            )

            parsed.loc[
                excel_dates.index
            ] = excel_dates


    # --------------------------------------------------------
    # Restrict to sensible future-dev years
    # --------------------------------------------------------

    valid = (
        parsed.notna()
        &
        (parsed.dt.year >= 2026)
        &
        (parsed.dt.year <= 2100)
    )

    parsed = parsed.where(
        valid,
        pd.NaT
    )


    # Normalize to first day of month
    parsed = (
        parsed
        .dt.to_period("M")
        .dt.to_timestamp()
    )

    return parsed


# ============================================================
# LOAD CONFIRMED FUTURE DEVELOPMENT
# ============================================================

def load_confirmed_future_dev(
    well_list_file,
    production_file
):

    # --------------------------------------------------------
    # WELL LIST
    #
    # A = Well Name
    # B = POP
    # C = API10
    # D = Facility
    # --------------------------------------------------------

    dev_map_raw = pd.read_csv(
        well_list_file
    )

    dev_map = dev_map_raw.iloc[
        :,
        [0, 3]
    ].copy()

    dev_map.columns = [
        "Well_Name",
        "Facility"
    ]

    dev_map["Well_Name"] = (
        dev_map["Well_Name"]
        .astype(str)
        .str.strip()
    )

    dev_map["Facility"] = (
        dev_map["Facility"]
        .astype(str)
        .str.strip()
    )

    dev_map["Match_Name"] = (
        dev_map["Well_Name"]
        .apply(normalize_well_name)
    )

    dev_map = dev_map[
        dev_map["Match_Name"] != ""
    ].copy()

    dev_map = (
        dev_map
        .drop_duplicates("Match_Name")
        .reset_index(drop=True)
    )


    # --------------------------------------------------------
    # HORIZONTAL DEVELOPMENT PRODUCTION FILE
    # --------------------------------------------------------

    raw = pd.read_csv(
        production_file,
        header=None
    )

    records = []

    ncols = raw.shape[1]


    for start_col in range(
        0,
        ncols,
        DEV_BLOCK_WIDTH
    ):

        if start_col >= ncols:
            break

        raw_well_name = raw.iloc[
            0,
            start_col
        ]

        if pd.isna(raw_well_name):
            continue

        well_name = str(
            raw_well_name
        ).strip()

        if (
            well_name == ""
            or
            well_name.lower() == "nan"
        ):
            continue


        if (
            start_col + DEV_GAS_OFFSET
            >= ncols
        ):
            continue


        # Excel row 5 = pandas row 4
        date_series = raw.iloc[
            4:,
            start_col + DEV_DATE_OFFSET
        ]

        oil_series = raw.iloc[
            4:,
            start_col + DEV_OIL_OFFSET
        ]

        gas_series = raw.iloc[
            4:,
            start_col + DEV_GAS_OFFSET
        ]


        temp = pd.DataFrame({

            "Well_Name":
                well_name,

            "Date":
                date_series.values,

            "Oil_BBL":
                oil_series.values,

            "Gas_MCF":
                gas_series.values

        })


        # ----------------------------------------------------
        # Parse dates
        # ----------------------------------------------------

        temp["Date"] = parse_dev_dates(
            temp["Date"]
        )

        temp = temp[
            temp["Date"].notna()
        ].copy()


        if len(temp) == 0:
            continue


        # ----------------------------------------------------
        # Numeric monthly volumes
        # ----------------------------------------------------

        temp["Oil_BBL"] = pd.to_numeric(
            temp["Oil_BBL"],
            errors="coerce"
        ).fillna(0)

        temp["Gas_MCF"] = pd.to_numeric(
            temp["Gas_MCF"],
            errors="coerce"
        ).fillna(0)


        temp[
            [
                "Oil_BBL",
                "Gas_MCF"
            ]
        ] = (
            temp[
                [
                    "Oil_BBL",
                    "Gas_MCF"
                ]
            ]
            .replace(
                [np.inf, -np.inf],
                0
            )
        )


        temp["Match_Name"] = (
            temp["Well_Name"]
            .apply(normalize_well_name)
        )


        records.append(
            temp
        )


    if len(records) == 0:

        raise ValueError(
            "No Confirmed Future Development "
            "well blocks were found."
        )


    dev = pd.concat(
        records,
        ignore_index=True
    )


    # --------------------------------------------------------
    # Attach Facility
    # --------------------------------------------------------

    dev = dev.merge(

        dev_map[
            [
                "Match_Name",
                "Facility"
            ]
        ],

        on="Match_Name",

        how="left"

    )


    # --------------------------------------------------------
    # QA unmapped wells
    # --------------------------------------------------------

    missing_facility = (

        dev.loc[
            dev["Facility"].isna(),
            "Well_Name"
        ]

        .drop_duplicates()

        .tolist()

    )

    if len(missing_facility) > 0:

        print(
            "WARNING: Future Dev wells "
            "without facility match:"
        )

        for well in missing_facility:

            print(
                "   ",
                well
            )


    dev = dev[
        dev["Facility"].notna()
    ].copy()


    # --------------------------------------------------------
    # Aggregate by Facility / Date
    # --------------------------------------------------------

    dev_facility = (

        dev.groupby(
            [
                "Facility",
                "Date"
            ],
            as_index=False
        )[
            [
                "Oil_BBL",
                "Gas_MCF"
            ]
        ]

        .sum()

        .sort_values(
            [
                "Facility",
                "Date"
            ]
        )

        .reset_index(drop=True)

    )


    return (
        dev,
        dev_facility,
        dev_map
    )


