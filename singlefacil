# Exact facility name used in Certain_Dev_Well_List.csv
FACILITY_TO_PLOT = "Blacktip Tankless 5.0 CPF"



# ============================================================
# SINGLE-FACILITY VERSION
# ADD CONFIRMED DEV TO MODIFIED PROFILE
# ============================================================

single_dev = (
    confirmed_dev_facility[
        confirmed_dev_facility[
            "Facility"
        ] == FACILITY_TO_PLOT
    ]
    .copy()
)


modified_plus_dev_single = pd.merge(
    modified_aggregated[
        [
            "Date",
            "Oil_BBL",
            "Gas_MCF",
            "Oil_BPD",
            "Gas_MCFD"
        ]
    ],
    single_dev[
        [
            "Date",
            "Oil_BBL",
            "Gas_MCF",
            "Oil_BPD",
            "Gas_MCFD"
        ]
    ],
    on="Date",
    how="outer",
    suffixes=(
        "_Modified",
        "_Dev"
    )
)

modified_plus_dev_single = (
    modified_plus_dev_single
    .sort_values("Date")
    .reset_index(drop=True)
)


cols = [
    "Oil_BBL_Modified",
    "Gas_MCF_Modified",
    "Oil_BPD_Modified",
    "Gas_MCFD_Modified",
    "Oil_BBL_Dev",
    "Gas_MCF_Dev",
    "Oil_BPD_Dev",
    "Gas_MCFD_Dev"
]

modified_plus_dev_single[
    cols
] = modified_plus_dev_single[
    cols
].fillna(0)


modified_plus_dev_single[
    "Oil_BBL_Combined"
] = (
    modified_plus_dev_single[
        "Oil_BBL_Modified"
    ]
    +
    modified_plus_dev_single[
        "Oil_BBL_Dev"
    ]
)

modified_plus_dev_single[
    "Gas_MCF_Combined"
] = (
    modified_plus_dev_single[
        "Gas_MCF_Modified"
    ]
    +
    modified_plus_dev_single[
        "Gas_MCF_Dev"
    ]
)


modified_plus_dev_single[
    "Oil_BPD_Combined"
] = (
    modified_plus_dev_single[
        "Oil_BPD_Modified"
    ]
    +
    modified_plus_dev_single[
        "Oil_BPD_Dev"
    ]
)

modified_plus_dev_single[
    "Gas_MCFD_Combined"
] = (
    modified_plus_dev_single[
        "Gas_MCFD_Modified"
    ]
    +
    modified_plus_dev_single[
        "Gas_MCFD_Dev"
    ]
)


modified_plus_dev_single[
    "Cum_Oil_Modified"
] = (
    modified_plus_dev_single[
        "Oil_BBL_Modified"
    ].cumsum()
)

modified_plus_dev_single[
    "Cum_Oil_Combined"
] = (
    modified_plus_dev_single[
        "Oil_BBL_Combined"
    ].cumsum()
)

modified_plus_dev_single[
    "Cum_Gas_Modified"
] = (
    modified_plus_dev_single[
        "Gas_MCF_Modified"
    ].cumsum()
)

modified_plus_dev_single[
    "Cum_Gas_Combined"
] = (
    modified_plus_dev_single[
        "Gas_MCF_Combined"
    ].cumsum()
)





















def plot_single_modified_plus_dev(
    df,
    stream="Oil"
):

    d = df.copy()

    if stream == "Oil":

        rmod = "Oil_BPD_Modified"
        rcombined = "Oil_BPD_Combined"

        cmod = "Cum_Oil_Modified"
        ccombined = "Cum_Oil_Combined"

        rate_unit = "BPD"
        cum_unit = "BBL"

    else:

        rmod = "Gas_MCFD_Modified"
        rcombined = "Gas_MCFD_Combined"

        cmod = "Cum_Gas_Modified"
        ccombined = "Cum_Gas_Combined"

        rate_unit = "MCF/D"
        cum_unit = "MCF"


    fig, ax1 = plt.subplots(
        figsize=(14, 7)
    )

    ax2 = ax1.twinx()


    modified_line, = ax1.plot(
        d["Date"],
        d[rmod],
        linewidth=2,
        label="Modified Profile"
    )


    combined_line, = ax1.plot(
        d["Date"],
        d[rcombined],
        linewidth=2,
        label=(
            "Modified + "
            "Confirmed Future Dev"
        )
    )


    # GREEN future-development addition
    ax1.fill_between(
        d["Date"],
        d[rmod],
        d[rcombined],
        color="green",
        alpha=0.30,
        label="Confirmed Future Dev"
    )


    mod_cum_line, = ax2.plot(
        d["Date"],
        d[cmod],
        "--",
        linewidth=2,
        label="Modified Cumulative"
    )


    combined_cum_line, = ax2.plot(
        d["Date"],
        d[ccombined],
        "--",
        linewidth=2,
        label=(
            "Modified + Dev Cumulative"
        )
    )


    ax2.fill_between(
        d["Date"],
        d[cmod],
        d[ccombined],
        color="green",
        alpha=0.10
    )


    peak_mod = d[rmod].max()
    peak_combined = d[rcombined].max()

    incremental = (
        d[ccombined].iloc[-1]
        -
        d[cmod].iloc[-1]
    )


    ax1.text(
        0.015,
        0.97,

        f"Peak Modified: "
        f"{peak_mod:,.0f} "
        f"{rate_unit}\n"

        f"Peak w/ Confirmed Dev: "
        f"{peak_combined:,.0f} "
        f"{rate_unit}\n"

        f"Confirmed Dev Increment: "
        f"{incremental:,.0f} "
        f"{cum_unit}",

        transform=ax1.transAxes,
        va="top",

        bbox=dict(
            boxstyle="round",
            facecolor="white",
            alpha=0.88
        )
    )


    ax1.set_title(
        f"{FACILITY_TO_PLOT} - "
        f"{stream}: Modified + "
        f"Confirmed Future Dev"
    )

    ax1.set_xlabel("Date")

    ax1.set_ylabel(
        f"{stream} Rate ({rate_unit})"
    )

    ax2.set_ylabel(
        f"Cumulative {stream} "
        f"({cum_unit})"
    )

    ax1.grid(
        True,
        alpha=0.3
    )


    ax1.legend(
        [
            modified_line,
            combined_line,
            mod_cum_line,
            combined_cum_line
        ],
        [
            "Modified Profile",
            "Modified + Confirmed Future Dev",
            "Modified Cumulative",
            "Modified + Confirmed Future Dev Cumulative"
        ],
        loc="upper right"
    )


    fig.tight_layout()

    plt.show()



















plot_single_modified_plus_dev(
    modified_plus_dev_single,
    stream="Oil"
)

plot_single_modified_plus_dev(
    modified_plus_dev_single,
    stream="Gas"
)
